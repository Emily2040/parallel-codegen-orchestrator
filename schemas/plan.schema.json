{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectPlan",
  "type": "object",
  "required": [
    "project_name",
    "overall_goal",
    "mode",
    "phase",
    "modules",
    "execution_waves",
    "completion_criteria"
  ],
  "properties": {
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "overall_goal": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "edit",
        "feature",
        "refactor",
        "greenfield",
        "debug"
      ]
    },
    "phase": {
      "type": "string",
      "const": "PLAN"
    },
    "tech_stack": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "frozen_interfaces": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "contract"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "contract": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "title",
          "description",
          "dependencies",
          "files",
          "verification",
          "can_parallelize"
        ],
        "properties": {
          "module_id": {
            "type": "string",
            "pattern": "^M-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^M-[0-9]{3}$"
            },
            "default": []
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "file_path",
                "purpose"
              ],
              "properties": {
                "file_path": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "interface_contracts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "owner_scope": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "estimated_effort": {
            "type": "string",
            "enum": [
              "S",
              "M",
              "L",
              "XL"
            ],
            "default": "M"
          },
          "verification": {
            "type": "object",
            "required": [
              "unit_tests",
              "integration_tests",
              "static_checks"
            ],
            "properties": {
              "unit_tests": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "integration_tests": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "static_checks": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "additionalProperties": false
          },
          "can_parallelize": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "execution_waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^M-[0-9]{3}$"
        }
      }
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
